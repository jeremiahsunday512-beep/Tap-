<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>FilmFusion - Watch Movies</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{background:#0a0a0a;color:#fff;font-family:sans-serif}
header{padding:20px;background:#111;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:10}
.logo{font-size:24px;font-weight:900;color:#e50914}
.search{padding:10px 15px;border-radius:20px;border:none;background:#222;color:#fff;width:200px}
.hero{padding:40px 20px;background:linear-gradient(to right,#000,#222);text-align:center}
.hero h1{font-size:32px;margin-bottom:10px}
.hero p{color:#aaa}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:15px;padding:20px}
.card{background:#1a1a1a;border-radius:10px;overflow:hidden;transition:.3s}
.card:hover{transform:scale(1.05)}
.card img{width:100%;height:220px;object-fit:cover}
.card-info{padding:10px}
.card-info h3{font-size:14px;margin-bottom:5px}
.card-info span{color:#e50914;font-size:12px}
.btn{display:block;background:#e50914;color:#fff;text-align:center;padding:8px;margin-top:8px;border-radius:5px;text-decoration:none;font-size:13px}
</style>
</head>
<body>
<header>
<div class="logo">FILM<span style="color:white">FUSION</span></div>
<input id="search" class="search" placeholder="Search movies...">
</header>
<div class="hero">
<h1>Unlimited Movies, TV Shows</h1>
<p>Watch anywhere. Anytime.</p>
</div>
<div id="movies" class="grid"></div>
<script>
const movies=[
{name:"John Wick 4",year:"2023",img:"https://image.tmdb.org/t/p/w500/vZloFAK7NmvMGKE7VkF5UHaz0I.jpg"},
{name:"Spider-Man: No Way Home",year:"2021",img:"https://image.tmdb.org/t/p/w500/1g0dhYtq4irTY1GPXvft6k4YLjm.jpg"},
{name:"Avengers Endgame",year:"2019",img:"https://image.tmdb.org/t/p/w500/or06FN3Dka5tukK1e9sl16pB3iy.jpg"},
{name:"The Batman",year:"2022",img:"https://image.tmdb.org/t/p/w500/74xTEgt7R36Fpooo50r9T25onhq.jpg"},
{name:"Avatar 2",year:"2022",img:"https://image.tmdb.org/t/p/w500/s16H6tpK2utvwDtzZ8Qy4qm5Emw.jpg"},
{name:"Fast X",year:"2023",img:"https://image.tmdb.org/t/p/w500/fiVW06jE7z9YnO4trhaMEdclSiC.jpg"},
{name:"Oppenheimer",year:"2023",img:"https://image.tmdb.org/t/p/w500/8Gxv8gSFCU0XGDykEGv7zR1n2ua.jpg"},
{name:"Interstellar",year:"2014",img:"https://image.tmdb.org/t/p/w500/gEU2QniE6E77NI6lCU6MxlNBvIx.jpg"}
];
const grid=document.getElementById('movies');
const search=document.getElementById('search');
function show(list){
grid.innerHTML=list.map(m=>`
<div class="card">
<img src="${m.img}">
<div class="card-info">
<h3>${m.name}</h3>
<span>${m.year} • HD</span>
<a class="btn" href="https://www.youtube.com/results?search_query=${m.name} trailer" target="_blank">Watch Now</a>
</div>
</div>
`).join('');
}
show(movies);
search.addEventListener('input',e=>{
const q=e.target.value.toLowerCase();
show(movies.filter(m=>m.name.toLowerCase().includes(q)));
});
</script>
</body>
</html>
